import asyncio
import json
import platform
import pygame

SERVER_URL = "ws://localhost:8765"   # lokální test
# SERVER_URL = "ws://192.168.3.84:8765"  # test z jiného zařízení v LAN

inbox = []   # zprávy přijaté ze serveru
ws = None

def on_open(event):
    print("Připojeno k serveru")

def on_message(event):
    inbox.append(event.data)

def on_close(event):
    print("Spojení ukončeno")

def connect():
    global ws
    ws = platform.window.WebSocket.new(SERVER_URL)
    # Pokud pygbag vyžaduje proxy pro Python funkce, použij:
    # from pyodide.ffi import create_proxy
    # ws.onmessage = create_proxy(on_message)
    ws.onopen = on_open
    ws.onmessage = on_message
    ws.onclose = on_close

def send(data):
    if ws is not None and ws.readyState == 1:
        ws.send(json.dumps(data))

async def main():
    pygame.init()
    screen = pygame.display.set_mode((400, 300))
    font = pygame.font.SysFont(None, 24)
    connect()

    log = []
    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN and event.key == pygame.K_RETURN:
                send({"text": "Ahoj ze hry!"})

        while inbox:
            log.append(inbox.pop(0))
            log = log[-10:]

        screen.fill((30, 30, 30))
        for i, line in enumerate(log):
            screen.blit(font.render(line, True, (255, 255, 255)), (10, 10 + i * 25))
        pygame.display.flip()

        await asyncio.sleep(0)   # nutné, aby prohlížeč nezamrzl

asyncio.run(main())